{
  "name": "orbit-school",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "db:init": "npm run db:init -w apps/api",
    "db:check": "npm run db:check -w apps/api",
    "start": "npm run start -w apps/api",
    "format": "prettier --write apps docs README.md package.json compose.yaml .github/workflows/ci.yml",
    "db:security": "npm run db:security -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
