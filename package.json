{
  "name": "orbit-school",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "db:init": "npm run db:init -w apps/api",
    "db:check": "npm run db:check -w apps/api",
    "start": "npm run start -w apps/api",
    "format": "prettier --write apps docs README.md package.json compose.yaml .github/workflows/ci.yml",
    "db:security": "npm run db:security -w apps/api",
    "db:relational": "npm run db:relational -w apps/api",
    "db:operations": "npm run db:operations -w apps/api",
    "backup:create": "npm run backup:create -w apps/api",
    "backup:verify": "npm run backup:verify -w apps/api --",
    "backup:restore": "npm run backup:restore -w apps/api --",
    "db:recovery": "npm run db:recovery -w apps/api",
    "db:grants": "npm run db:grants -w apps/api --",
    "db:permissions": "npm run db:permissions -w apps/api",
    "deploy:check": "npm run deploy:check -w apps/api --",
    "test:e2e": "npm run build && playwright test",
    "test:browsers": "npm run build && node scripts/browser-matrix.js",
    "test:capacity": "node scripts/capacity-check.js",
    "monitor:probe": "node apps/api/src/uptime-cli.js",
    "release:verify": "node scripts/release-verify.js",
    "release:container": "node scripts/container-verify.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "date-holidays": "^3.37.0",
    "exceljs": "4.4.0",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.20.2"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "uuid": "11.1.1"
  }
}
