# EAS stages the Git root. Upload only files needed by the mobile build.
/*
!/.easignore
!/apps
/apps/*
!/apps/mobile
/apps/mobile/*
!/apps/mobile/src
!/apps/mobile/assets
!/apps/mobile/app.json
!/apps/mobile/eas.json
!/apps/mobile/package.json
!/apps/mobile/package-lock.json
!/apps/mobile/tsconfig.json
!/apps/mobile/.npmrc
!/apps/mobile/.gitignore
!/apps/mobile/LICENSE

# Defense in depth for future files inside allowed directories.
**/.git
**/node_modules/
**/.pilot/
**/.expo/
**/.env
**/.env.*
**/credentials.json
**/credentials.*.json
**/signing/
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/*.pem
