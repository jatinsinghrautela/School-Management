# Protected runtime environment only; never commit filled credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
TRUST_PROXY=loopback
DATA_MODE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=schoolglass
MYSQL_USER=schoolglass_runtime
# Blank intentionally: unique random secret, at least 20 characters.
MYSQL_PASSWORD=
MYSQL_AUTO_MIGRATE=no
# Blank until an HTTPS hostname is available.
PUBLIC_APP_URL=
# Disabled until real delivery/scanning acceptance is complete.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CLAMAV_COMMAND=
SCHOOL_STORAGE_MB=250
STUDENT_STORAGE_MB=20
# No migration/recovery credentials, bootstrap password or backup key here.
