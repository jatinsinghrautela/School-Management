NODE_ENV=production
DEPLOYMENT_PROFILE=render
HOST=0.0.0.0
TRUST_PROXY=1
# RENDER=true and PORT are supplied by Render; do not override them.
DATA_MODE=mysql
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_AUTO_MIGRATE=no
MYSQL_TLS=required
MYSQL_CA_FILE=/etc/secrets/aiven-ca.pem
PUBLIC_APP_URL=https://schoolglass.jatinsinghrautela.com
FILE_STORAGE=r2
R2_ENDPOINT=
R2_BUCKET=schoolglass-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MAX_BYTES=8000000000
R2_MAX_CLASS_A=500000
R2_MAX_CLASS_B=5000000
R2_PAUSED=no
# Explicitly authorized pilot uploads without malware scanning.
UPLOAD_SCAN_MODE=unscanned
SCHOOL_STORAGE_MB=250
STUDENT_STORAGE_MB=20
