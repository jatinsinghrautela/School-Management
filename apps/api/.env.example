PORT=4000
HOST=127.0.0.1
# Production uses a local HTTPS reverse proxy and requires exactly loopback.
TRUST_PROXY=
# mysql is the production persistence mode; demo is explicitly opt-in and ephemeral.
DATA_MODE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=orbit
MYSQL_PASSWORD=local-development-only
MYSQL_DATABASE=orbit_school
# Development only: yes enables automatic migrations. Production always skips them.
# After db:init with separate migration credentials, use no for a restricted runtime account.
MYSQL_AUTO_MIGRATE=yes
BOOTSTRAP_EMAIL=owner@orbit.local
BOOTSTRAP_PASSWORD=ChangeThisBeforeUse123!

# Optional existing SMTP infrastructure. Email stays disabled until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=

# Local ClamAV executable; uploads stay disabled until configured.
# Keep virus definitions current with freshclam; never use a dummy command.
CLAMAV_COMMAND=
SCHOOL_STORAGE_MB=250
STUDENT_STORAGE_MB=20

# Offline encrypted backups. Supply a long random passphrase only for the operation.
# Never commit it, log it or store it alongside backup files.
BACKUP_PASSPHRASE=
# Set yes only after stopping every API worker/writer/cleanup/migration.
BACKUP_MAINTENANCE_CONFIRMED=
# Separate recovery credentials, used only for new isolated databases.
RESTORE_MYSQL_HOST=
RESTORE_MYSQL_PORT=
RESTORE_MYSQL_USER=
RESTORE_MYSQL_PASSWORD=
