{
  "expo": {
    "name": "Schoolglass Desk",
    "slug": "schoolglass-desk",
    "version": "0.1.1",
    "scheme": "schoolglass",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jatinsinghrautela.schoolglass",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.jatinsinghrautela.schoolglass",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123f3a"
      },
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eef665c0-7729-4f71-89f2-99daf806fa68"
      }
    },
    "owner": "jatinsinghrautela"
  }
}
